# AI planning (required before DayCraft can craft a day)
# Prefer a deployment secret manager in production. Alternatively, a user can
# enter either provider key for their current browser session in the UI.
# DAYCRAFT_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Google Calendar and Gmail OAuth
# Create a Web application OAuth client in Google Cloud, enable the Calendar
# and/or Gmail API, then add this exact URL to Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501

# Required when Google Calendar or Gmail is enabled. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DAYCRAFT_ENCRYPTION_KEY=

# Optional operational settings
# DAYCRAFT_DATABASE_PATH=data/daycraft.db
# DAYCRAFT_TIMEZONE=Asia/Kolkata
# DAYCRAFT_MCP_USER_EMAIL=you@example.com
