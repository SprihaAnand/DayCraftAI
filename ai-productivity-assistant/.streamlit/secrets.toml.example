# Copy these root-level keys into Streamlit Community Cloud's Advanced settings.
# Never create a committed secrets.toml with real values.

# AI day planner (required to craft a day)
DAYCRAFT_AI_PROVIDER = "gemini"
GEMINI_API_KEY = "replace-with-your-gemini-key"
GEMINI_MODEL = "gemini-3.8-flash"

# Or replace the three AI settings above with OpenAI:
# DAYCRAFT_AI_PROVIDER = "openai"
# OPENAI_API_KEY = "replace-with-your-openai-key"
# OPENAI_MODEL = "gpt-5.2"

# Google Calendar and Gmail OAuth.
# Set GOOGLE_REDIRECT_URI to the exact public URL selected in Community Cloud.
GOOGLE_CLIENT_ID = "replace-with-your-google-client-id"
GOOGLE_CLIENT_SECRET = "replace-with-your-google-client-secret"
GOOGLE_REDIRECT_URI = "https://your-subdomain.streamlit.app"

# Generate a new value with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DAYCRAFT_ENCRYPTION_KEY = "replace-with-a-new-fernet-key"
DAYCRAFT_TIMEZONE = "Asia/Kolkata"
